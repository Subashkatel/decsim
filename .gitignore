# Python bytecode/cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments and installed dependencies
.venv/
.pydeps/
.env
.env.*

# Build artifacts. The pattern is anchored to the root: decsim/build/ is
# the machine's build script, not an artifact.
/build/
*.egg-info/

# The compiled Union-Find decoder, built from its C source by
# tools/build_union_find.sh. Source is tracked, objects are not.
*.so

# Editor/OS noise
.DS_Store

# Stray slurm logs at the repo root; every run keeps its own copies
# under results/<run>/logs/
/slurm-*.out

# Run output. A results folder's stats.csv, commit record, script copy
# and plots are tracked, so every experiment's evidence has one place;
# each point's working CSV and the Slurm logs stay with the run.
/results/*/points/
/results/*/logs/
# A decsim plan experiment's folder: its tasks write here while they
# check the tree is clean; its summaries are copied up a level.
/results/*/run/

# Core dumps
core.[0-9]*

# The Deltakit Explorer client writes its log into the working directory
# whenever it is imported.
client.log
