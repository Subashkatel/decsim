# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Build/package artifacts
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Local environment/config
.env
.env.*

# Tool/editor/OS noise
.mypy_cache/
.ruff_cache/
.DS_Store
Thumbs.db
*.png

# Local research notes and experiment scripts.
# Claim-bearing text (predeclarations, ledger, reviews, pitch matrix)
# IS tracked so declaration timing is git-auditable (Codex G7P1
# review finding 1, 2026-07-04); bulky literature/data trees stay local.
docs/*
!docs/validation/
!docs/claims/
!docs/reviews/
!docs/pitch/
!docs/papers/
tools/
tmp/

# Experiments: artifact dirs are small text/json — tracked for audit
# (same review finding); anything bulky must go under a raw_big/ dir
experiments/results/*/raw_big/

# Replication-run artifacts (regenerated by benchmarks/replicate_*.py)
benchmarks/out/

# Scratch extraction areas (re-extractable from archived artifacts)
experiments/scratch*/

# Verification, review, and audit write-ups are private working notes.
# They live in the sandbox alongside the repo, never in the package.
/*_REPORT.md
/*_REVIEW.md
/AUDIT_*.md
/VERIFY_*.md
/REVIEW_*.md
/HANDOFF_*.md
/DESIGN_*.md
/*.html
