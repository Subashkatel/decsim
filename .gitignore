# Python bytecode/cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environments and installed dependencies
.venv/
.pydeps/
.env
.env.*

# Build artifacts. The pattern is anchored to the root: decsim/build/ is
# the machine's build script, not an artifact.
/build/
*.egg-info/

# The compiled Union-Find decoder, built from its C source by
# tools/build_union_find.sh. Source is tracked, objects are not.
*.so

# Editor/OS noise
.DS_Store

# Stray slurm logs at the repo root; every run keeps its own copies
# under results/<run>/logs/
/slurm-*.out

# Run output. A results folder's summaries (sweep.csv, stats.csv and
# the like), run.json, code state and script copy are tracked, so
# every experiment's evidence has one place; each point's records and
# working CSV, the pieces, the batches, the traces and the logs stay
# with the run.
/results/*/points/
/results/*/pieces/
/results/*/batches/
/results/*/trace/
/results/*/log/
/results/*/logs/
/results/*/run/

# Core dumps
core.[0-9]*

# The Deltakit Explorer client writes its log into the working directory
# whenever it is imported.
client.log
