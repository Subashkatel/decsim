# A distance-3 rotated surface-code Z memory of 8 rounds that measures
# the Z ancillas, then the X ancillas, as two blocks per round.
# Made with deltakit-explorer 0.9.2 and stim 1.16.0:
#   code = codes.RotatedPlanarCode(
#       width=3, height=3, schedule_type=codes.ScheduleType.Z_FIRST)
#   memory = codes.css_code_memory_circuit(code, 8, gates.PauliBasis.Z)
#   device = qpu.QPU(code.qubits,
#       native_gates_and_times=qpu.ExhaustiveGateSet(),
#       noise_model=qpu.SD6Noise(p=0.01), maximise_parallelism=False)
#   noisy = device.compile_and_add_noise_to_circuit(
#       device.compile_circuit(memory))
#   stim.Circuit(str(noisy.as_stim_circuit()))
# The device settings are memory_circuit's in decsim/frontends/
# deltakit.py, which keeps the default SIMULTANEOUS schedule.
# A rerun may list the data-qubit reset targets in another order
# (Python set order); the measurement records are the same.
QUBIT_COORDS(2, 4) 0
QUBIT_COORDS(4, 0) 1
QUBIT_COORDS(1, 5) 2
QUBIT_COORDS(3, 1) 3
QUBIT_COORDS(5, 1) 4
QUBIT_COORDS(6, 4) 5
QUBIT_COORDS(0, 2) 6
QUBIT_COORDS(2, 2) 7
QUBIT_COORDS(1, 3) 8
QUBIT_COORDS(3, 5) 9
QUBIT_COORDS(4, 4) 10
QUBIT_COORDS(5, 5) 11
QUBIT_COORDS(1, 1) 12
QUBIT_COORDS(4, 2) 13
QUBIT_COORDS(3, 3) 14
QUBIT_COORDS(2, 6) 15
QUBIT_COORDS(5, 3) 16
R 11 2 8 3 14 9 16 4 12
RX 1 10 15 7
TICK
X_ERROR(0.01) 11 2 8 3 14 9 16 4 12
Z_ERROR(0.01) 1 10 15 7
DEPOLARIZE1(0.01) 0 5 6 13
