DETECTOR(2, 2, 0) rec[-5]
SHIFT_COORDS(0, 0, 1)
DEPOLARIZE1(0.01) 1 2 3 4 7 8 9 10 11 12 14 15 16
REPEAT 6 {
    RX 1 10 15 7
    TICK
    Z_ERROR(0.01) 1 10 15 7
    DEPOLARIZE1(0.01) 0 2 3 5 4 6 8 9 11 12 13 14 16
    CZ 1 3 10 9 7 8
    TICK
