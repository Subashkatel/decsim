    MX(0.01) 5 0 13 6
    DETECTOR(4, 0, 0) rec[-8] rec[-16]
    DETECTOR(4, 4, 0) rec[-7] rec[-15]
    DETECTOR(2, 6, 0) rec[-6] rec[-14]
    DETECTOR(2, 2, 0) rec[-5] rec[-13]
    DETECTOR(6, 4, 0) rec[-4] rec[-12]
    DETECTOR(2, 4, 0) rec[-11] rec[-3]
    DETECTOR(4, 2, 0) rec[-2] rec[-10]
    DETECTOR(0, 2, 0) rec[-1] rec[-9]
    SHIFT_COORDS(0, 0, 1)
    DEPOLARIZE1(0.01) 1 2 3 4 7 8 9 10 11 12 14 15 16
    TICK
}
